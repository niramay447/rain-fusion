#!/bin/bash
#PBS -N smoke_full
#PBS -P no50
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=04:00:00
#PBS -l storage=scratch/no50+gdata/no50+gdata/rq0+gdata/rv74
#PBS -j oe
#PBS -o /scratch/no50/nk4326/rain-fusion/logs/smoke_full.log
#PBS -r y

# FULL-pipeline smoketest: gauge+radar+satellite, 1 fold, 4 epochs.
# Purpose: (1) rebuild radar + satellite caches from raw /g/data with the
# start-of-period hour fix, (2) exercise the new 2-channel radar + 75-station
# dataset end-to-end, (3) confirm loss is a real number (NOT nan) before the
# long runs. If loss prints as nan on epoch 1, stop — that indicates a raw NaN
# in the radar field (see the radar-sanitisation note).
# Submit: qsub run_smoketest_full.pbs

set -euo pipefail

PROJECT_DIR=/scratch/no50/nk4326/rain-fusion
mkdir -p "${PROJECT_DIR}/logs" "${PROJECT_DIR}/experiments"

echo "======================================================"
echo "FULL smoketest — gauge+radar+satellite (1 fold, 4 epochs)"
echo "Node    : $(hostname)"
echo "Started : $(date)"
echo "======================================================"

module load python3/3.11.7
source /scratch/no50/nk4326/venvs/radar_sat/bin/activate

echo "Python  : $(which python3)"
echo "PyTorch : $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA    : $(python3 -c 'import torch; print(torch.cuda.is_available())')"

cd "${PROJECT_DIR}"

python3 train.py \
    --config config_gauge_radar_satellite.yaml \
    --tag smoke_full \
    --smoketest

echo "Finished: $(date)"
