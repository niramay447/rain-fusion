#!/bin/bash
#PBS -N wagga_grs_gate
#PBS -P no50
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/no50+gdata/no50+gdata/rq0+gdata/rv74
#PBS -j oe
#PBS -o /scratch/no50/nk4326/rain-fusion/logs/wagga_radar_satellite_gate.log
#PBS -r y

# WAGGA gauge+radar+satellite, hetero_aggr=gate, first 2 folds (fast proof that
# gating prevents the satellite COLLAPSE). Success = val NOT pinned at ~0.70,
# result ~+radar level (~0.63) not ~0.21. Compare vs mean (collapsed).
# Submit: qsub run_wagga_radar_satellite_gate.pbs

set -euo pipefail
PROJECT_DIR=/scratch/no50/nk4326/rain-fusion
mkdir -p "${PROJECT_DIR}/logs" "${PROJECT_DIR}/experiments"
echo "WAGGA gauge+radar+satellite | gate | 2 folds | $(date)"
module load python3/3.11.7
source /scratch/no50/nk4326/venvs/radar_sat/bin/activate
cd "${PROJECT_DIR}"

python3 train.py \
    --config config_wagga_radar_satellite.yaml \
    --tag wagga_radar_satellite_gate \
    --max-folds 2

echo "Finished: $(date)"
