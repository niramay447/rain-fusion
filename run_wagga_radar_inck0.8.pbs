#!/bin/bash
#PBS -N wagga_radar_inck0.8
#PBS -P no50
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=64GB
#PBS -l walltime=24:00:00
#PBS -l storage=scratch/no50+gdata/no50+gdata/rq0
#PBS -j oe
#PBS -o /scratch/no50/nk4326/rain-fusion/logs/wagga_radar_inck0.8.log
#PBS -r y

# WAGGA gauge+radar + log + weighted_loss_alpha=0.8 (5 layers, mean-aggr).
# Submit: qsub run_wagga_radar_inck0.8.pbs

set -euo pipefail

PROJECT_DIR=/scratch/no50/nk4326/rain-fusion
mkdir -p "${PROJECT_DIR}/logs" "${PROJECT_DIR}/experiments"

echo "WAGGA gauge+radar 5-fold | log + alpha=0.8 | $(date)"

module load python3/3.11.7
source /scratch/no50/nk4326/venvs/radar_sat/bin/activate

cd "${PROJECT_DIR}"

sed 's/weighted_loss_alpha: 0.18/weighted_loss_alpha: 0.8/' \
    config_wagga_radar.yaml > config_wagga_radar_inck0.8.yaml

python3 train.py \
    --config config_wagga_radar_inck0.8.yaml \
    --tag wagga_radar_log_inck_0.8

echo "Finished: $(date)"
