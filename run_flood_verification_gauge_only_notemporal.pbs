#!/bin/bash
#PBS -N flood_verify_g
#PBS -P no50
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/no50+gdata/no50
#PBS -j oe
#PBS -o /scratch/no50/nk4326/rain-fusion/logs/flood_verify_gauge_only_notemporal.log
#PBS -r y

# Categorical (POD/FAR/CSI) verification for the gauge-only no-temporal
# model. Inference-only against the existing checkpoint in
# experiments/20260603_213649_gauge_only_notemporal — no retraining. This is
# the plain (non-_log) checkpoint, which is what's being reported. Uses
# config_gauge_only_notemporal_nolog.yaml (log_transform False) to match how
# that checkpoint was actually trained. Requires the corrected 75-station
# dataset (Waverley Reservoir 566114 restored at its natural row position)
# to be synced first.
# Submit: qsub run_flood_verification_gauge_only_notemporal.pbs

set -euo pipefail

PROJECT_DIR=/scratch/no50/nk4326/rain-fusion
mkdir -p "${PROJECT_DIR}/logs"

echo "======================================================"
echo "Flood verification — gauge only, no-temporal"
echo "Node    : $(hostname)"
echo "Started : $(date)"
echo "======================================================"

module load pytorch/2.12.0
source /scratch/no50/nk4326/venvs/radar_sat_v2/bin/activate

echo "Python  : $(which python3)"
echo "PyTorch : $(python3 -c 'import torch; print(torch.__version__)')"

cd "${PROJECT_DIR}"

python3 flood_verification.py \
    --config config_gauge_only_notemporal_nolog.yaml \
    --experiment-dir experiments/20260603_213649_gauge_only_notemporal \
    --fold all

echo "Finished: $(date)"
