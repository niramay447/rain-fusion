#!/bin/bash
#PBS -N wagga_gauge_L2
#PBS -P no50
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=06:00:00
#PBS -l storage=scratch/no50+gdata/no50
#PBS -j oe
#PBS -o /scratch/no50/nk4326/rain-fusion/logs/wagga_gauge_L2.log
#PBS -r y

# WAGGA gauge-only + log, num_layers 5 -> 2 (oversmoothing test).
# One-variable vs the existing 5-layer gauge-log baseline: same log + alpha 0.18,
# only depth changes. Watch global r / station-median RMSE move toward IDW
# (0.690 / 0.522). Whichever depth wins → use it for the loss ablation.
# Submit: qsub run_wagga_gauge_L2.pbs

set -euo pipefail

PROJECT_DIR=/scratch/no50/nk4326/rain-fusion
mkdir -p "${PROJECT_DIR}/logs" "${PROJECT_DIR}/experiments"

echo "WAGGA gauge-only 5-fold | log + num_layers=2 | $(date)"

module load python3/3.11.7
source /scratch/no50/nk4326/venvs/rainfall/bin/activate

cd "${PROJECT_DIR}"

# Derive a per-job config with 2 layers (base stays at 5).
sed 's/num_layers: 5/num_layers: 2/' \
    config_wagga_gauge.yaml > config_wagga_gauge_L2.yaml

python3 train.py \
    --config config_wagga_gauge_L2.yaml \
    --tag wagga_gauge_log_L2

echo "Finished: $(date)"
