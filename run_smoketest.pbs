#!/bin/bash
#PBS -N smoketest
#PBS -P no50
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=00:30:00
#PBS -l storage=scratch/no50+gdata/no50
#PBS -j oe
#PBS -o /scratch/no50/nk4326/rain-fusion/logs/smoke.log
#PBS -r y

# Gauge-only smoketest: 1 fold, 4 epochs.
# Use this to verify code changes before submitting full runs.
# Submit: qsub run_smoketest.pbs

set -euo pipefail

PROJECT_DIR=/scratch/no50/nk4326/rain-fusion
mkdir -p "${PROJECT_DIR}/logs" "${PROJECT_DIR}/experiments"

echo "======================================================"
echo "Smoketest — gauge only"
echo "Node    : $(hostname)"
echo "Started : $(date)"
echo "======================================================"

module load python3/3.11.7
source /scratch/no50/nk4326/venvs/rainfall/bin/activate

echo "Python  : $(which python3)"
echo "PyTorch : $(python3 -c 'import torch; print(torch.__version__)')"
echo "CUDA    : $(python3 -c 'import torch; print(torch.cuda.is_available())')"

cd "${PROJECT_DIR}"

python3 train.py \
    --config config_gauge_only.yaml \
    --tag smoketest \
    --smoketest

echo "Finished: $(date)"
