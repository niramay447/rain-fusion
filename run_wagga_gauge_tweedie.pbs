#!/bin/bash
#PBS -N wagga_gauge_tweedie
#PBS -P no50
#PBS -q gpuvolta
#PBS -l ncpus=12
#PBS -l ngpus=1
#PBS -l mem=32GB
#PBS -l walltime=06:00:00
#PBS -l storage=scratch/no50+gdata/no50
#PBS -j oe
#PBS -o /scratch/no50/nk4326/rain-fusion/logs/wagga_gauge_tweedie.log
#PBS -r y

# WAGGA gauge-only + log + Tweedie loss (5 layers, p=1.6). Under-prediction fix:
# zero-inflated likelihood, variance ~ mu^p so large predictions aren't punished
# like MSE -> less hedging toward zero. Watch global r / station-median RMSE vs
# IDW (0.690/0.522).
# Submit: qsub run_wagga_gauge_tweedie.pbs

set -euo pipefail

PROJECT_DIR=/scratch/no50/nk4326/rain-fusion
mkdir -p "${PROJECT_DIR}/logs" "${PROJECT_DIR}/experiments"

echo "WAGGA gauge-only 5-fold | log + Tweedie (p=1.6) | $(date)"

module load python3/3.11.7
source /scratch/no50/nk4326/venvs/rainfall/bin/activate

cd "${PROJECT_DIR}"

# Per-job config: enable Tweedie loss (base stays MSE/weighted).
sed 's/use_tweedie: False/use_tweedie: True/' \
    config_wagga_gauge.yaml > config_wagga_gauge_tweedie.yaml

python3 train.py \
    --config config_wagga_gauge_tweedie.yaml \
    --tag wagga_gauge_log_tweedie

echo "Finished: $(date)"
